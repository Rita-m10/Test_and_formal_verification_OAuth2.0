		{
			"name": "Change redirect_uri",
			"item": [
				{
					"name": "Запрос на авторизацию",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"var str = pm.response.headers.get(\"location\").split(\"&\");\r",
									"\r",
									"pm.globals.set(\"state\", str[0].split(\"=\")[1])\r",
									"pm.globals.set(\"scope\", str[1].split(\"=\")[1])\r",
									"pm.globals.set(\"redirect_uri\", str[4].split(\"=\")[1])\r",
									"pm.globals.set(\"client_id\", str[5].split(\"=\")[1])"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"protocolProfileBehavior": {
						"followRedirects": false,
						"disableBodyPruning": true,
